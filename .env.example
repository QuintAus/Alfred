# ============================================================================
# J.A.R.V.I.S. environment variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored, so your real keys are never committed.
# ============================================================================

# Anthropic API key — JARVIS's brain (Phase 2+).
# Get one at https://console.anthropic.com/  →  Settings  →  API Keys.
# If this is unset, the dashboard still runs, in DEMO mode (canned responses)
# so you can see the orchestration loop without a key.
ANTHROPIC_API_KEY=

# --- Google integration (Phase 3 — Calendar / Gmail / Drive / Tasks) ---
# Google Cloud Console → APIs & Services → Credentials → "OAuth client ID"
# (Application type: Web application). Add the redirect URI below to that
# client's "Authorised redirect URIs". Leave these blank to keep using mock data.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Any long random string — encrypts the stored OAuth tokens at rest.
# Generate one with:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- Voice (Phase 4) ---
# Optional: the "Hey JARVIS" wake word via Picovoice Porcupine.
#   1) Free access key from https://console.picovoice.ai/
#   2) Download the English params model `porcupine_params.pv` and drop it in
#      public/  (from github.com/Picovoice/porcupine → lib/common/porcupine_params.pv)
# Without these, push-to-talk and spoken replies still work — only the wake word is off.
NEXT_PUBLIC_PICOVOICE_ACCESS_KEY=
# NEXT_PUBLIC_PORCUPINE_MODEL_PATH=/porcupine_params.pv

# --- Spotify (Phase 5 — Now Playing + "play my focus playlist") ---
# Create an app at https://developer.spotify.com/dashboard, add the redirect URI
# below, and copy the client id/secret here. Needs TOKEN_ENCRYPTION_KEY too.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback

# --- Phase 5 extras (all optional) ---
# Weather defaults to this place when none is given (real data via Open-Meteo, no key):
# DEFAULT_WEATHER_LOCATION=Malibu
# Better web search than the keyless fallback: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=
# Cinematic voice via ElevenLabs (set USE_ELEVENLABS=true to switch the app over):
# NEXT_PUBLIC_USE_ELEVENLABS=true
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
