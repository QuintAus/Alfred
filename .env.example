# ============================================================================
# J.A.R.V.I.S. environment variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored, so your real keys are never committed.
# ============================================================================

# Anthropic API key — JARVIS's brain (Phase 2+).
# Get one at https://console.anthropic.com/  →  Settings  →  API Keys.
# If this is unset, the dashboard still runs, in DEMO mode (canned responses)
# so you can see the orchestration loop without a key.
ANTHROPIC_API_KEY=

# --- Coming in later phases (leave blank for now) ---
# Google OAuth (Phase 3 — Calendar / Gmail / Drive / Tasks)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# TOKEN_ENCRYPTION_KEY=        # 32-byte key for encrypting OAuth tokens at rest
#
# Picovoice Porcupine wake word (Phase 4)
# NEXT_PUBLIC_PICOVOICE_ACCESS_KEY=
